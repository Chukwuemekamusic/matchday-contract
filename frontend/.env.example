# ---------- Public (bundled into the browser) ----------
# "base" or "base-sepolia"
NEXT_PUBLIC_CHAIN=base
# MatchDayBet proxy
NEXT_PUBLIC_CONTRACT_ADDRESS=0x1b048C7323C7c7FE910a5F0e08B36b0c715e8947
# Recommended: a dedicated RPC (Alchemy, QuickNode, ...). Falls back to the public Base RPC.
NEXT_PUBLIC_RPC_URL=
# WalletConnect Cloud project id (https://cloud.reown.com) — needed for mobile / WalletConnect wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/122239/matchdaybet-v-2/v0.3.0
# Public URL of the app, used for share images (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=

# ---------- Server only (never prefix with NEXT_PUBLIC_) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FOOTBALL_DATA_API_KEY=
# football-data.org competition codes to offer
FOOTBALL_COMPETITIONS=PL,PD,BL1,SA,FL1,CL
# Private key of the keeper wallet (must be a match manager on the contract). Keep only a little ETH in it.
KEEPER_PRIVATE_KEY=
# Shared secret Supabase pg_cron sends to the keeper routes (generate: openssl rand -hex 32)
KEEPER_CRON_SECRET=
# Optional server-side RPC for the keeper (defaults to NEXT_PUBLIC_RPC_URL)
RPC_URL=

# ---------- Alerts (optional) ----------
# Discord or Slack incoming-webhook URL; health problems are posted after each resolve run
ALERT_WEBHOOK_URL=
# Alert when the keeper wallet balance drops below this many ETH (default 0.002)
KEEPER_MIN_BALANCE_ETH=0.002
# Re-send an unresolved alert at most every N hours (default 6)
ALERT_REPEAT_HOURS=6
